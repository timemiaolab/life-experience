# 站点本身是静态的，前端不需要任何密钥。

# 仅用于本地运行整理脚本 scripts/ingest.ts
# GEMINI_API_KEY=
# SILICONFLOW_API_KEY=
# SILICONFLOW 默认 https://api.siliconflow.com/v1/chat/completions
#
# 模型（也可在仓库 Settings → Variables 配置同名变量）
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
